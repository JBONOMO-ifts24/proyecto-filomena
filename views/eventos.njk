{% extends "layout.njk" %}
{% block title %}Eventos - Filomena Arte y Diseño{% endblock %}
{% block content %}
    <div style="margin-top: 2rem;">
        <h1 style="color: var(--primary-color); font-size: 2.5rem; text-align: center; margin-bottom: 2.5rem;">Próximos Eventos</h1>

        <div style="display: flex; justify-content: center; gap: 0.75rem; margin-bottom: 2rem; flex-wrap: wrap;">
            <a href="/eventos?filtro=todos" class="btn-primary" style="padding: 0.7rem 1.2rem; text-decoration: none; background: {{ '#4bec53' if filtroActual == 'todos' else 'var(--accent-color)' }};">Todos</a>
            <a href="/eventos?filtro=hoy" class="btn-primary" style="padding: 0.7rem 1.2rem; text-decoration: none; background: {{ '#4bec53' if filtroActual == 'hoy' else 'var(--accent-color)' }};">Hoy</a>
            <a href="/eventos?filtro=7dias" class="btn-primary" style="padding: 0.7rem 1.2rem; text-decoration: none; background: {{ '#4bec53' if filtroActual == '7dias' else 'var(--accent-color)' }};">Próximos 7 días</a>
        </div>

        {% if eventos.length == 0 %}
            <p style="text-align: center; color: var(--text-light); font-size: 1.1rem;">Por el momento no hay eventos programados.
                ¡Vuelve pronto!</p>
        {% else %}
            <div
                class="grid-auto-fill"
                style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 2rem;">
                {% for evento in eventos %}
                    <div style="background: var(--surface); border: 1px solid var(--glass-border); border-radius: 16px; padding: 2rem; box-shadow:
                            var(--shadow-md); backdrop-filter: blur(10px); transition: transform 0.3s ease;">
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
                            <span style="background: var(--accent-color); color: white; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.85rem;
                                    font-weight: 600; text-transform: uppercase;">
                                {{ evento.tipo }}
                            </span>
                            <span style="background: rgba(132, 110, 86, 0.1); color: var(--primary-color); padding: 0.45rem 0.8rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;">
                                {{ evento.recurrencia_label or 'Evento único' }}
                            </span>

                        </div>
                        <h2 style="color: var(--primary-color); font-size: 1.6rem; margin-bottom: 1rem;">{{ evento.tipo }} en
                        {{ evento.lugar }}</h2>
                        <div style="display: flex; flex-direction: column; gap: 0.8rem; color: var(--text-main);">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    style="color: var(--accent-color);">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <span class="local-date" data-utc="{{ evento.fecha_hora | isoDate }}">Fecha no disponible</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    style="color: var(--accent-color);">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <span class="local-time" data-utc="{{ evento.fecha_hora | isoDate }}">Hora no disponible</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    style="color: var(--accent-color);">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span>{{ evento.lugar }}</span>
                            </div>
                        </div>
                        {% if evento.descripcion %}
                            <p style="margin-top: 1.5rem; color: var(--text-main); line-height: 1.5; font-style: italic; background: rgba(0,0,0,0.02);
                                    padding: 1rem; border-radius: 8px; border-left: 3px solid var(--accent-color);">
                                {{ evento.descripcion }}
                            </p>
                        {% endif %}
                        <div style="margin-top: 2rem;">
                            {% if evento.googleMapsUrl %}
                                {% set mapUrl = evento.googleMapsUrl %}
                                {% if mapUrl.indexOf('http') != 0 %}
                                    {% set mapUrl = "https://www.google.com/maps/search/?api=1&query=" + (evento.googleMapsUrl | urlencode) %}
                                {% endif %}
                                <a href="{{ mapUrl }}" target="_blank" class="btn-primary" style="display: inline-block; text-align: center; text-decoration: none; padding: 0.8rem 1.5rem;">Ver
                                                        en Google Maps</a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.local-date').forEach(el => {
                const utc = el.getAttribute('data-utc');
                if (utc) {
                    const date = new Date(utc);
                    if (!isNaN(date.getTime())) {
                        el.textContent = date.toLocaleDateString([], {
                            day: '2-digit',
                            month: '2-digit',
                            year: 'numeric'
                        });
                    }
                }
            });
            document.querySelectorAll('.local-time').forEach(el => {
                const utc = el.getAttribute('data-utc');
                if (utc) {
                    const date = new Date(utc);
                    if (!isNaN(date.getTime())) {
                        el.textContent = date.toLocaleTimeString([], {
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                    }
                }
            });
        });
    </script>
{% endblock %}